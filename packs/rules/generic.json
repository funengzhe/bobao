{
  "name": "通用",
  "description": "常见的收款、注册、告警、日报标题。没有更具体的规则包时用它。",
  "rules": [
    {
      "when": {
        "title": [
          "已恢复",
          "恢复正常",
          "RESOLVED",
          "Resolved"
        ]
      },
      "type": "恢复"
    },
    {
      "when": {
        "title": [
          "测试",
          "模拟"
        ]
      },
      "type": "通知",
      "skip": true
    },
    {
      "when": {
        "title": [
          "退款成功",
          "支付失败",
          "付款失败"
        ]
      },
      "type": "提醒",
      "name": "有一笔订单出问题了"
    },
    {
      "when": {
        "title": [
          "套餐购买",
          "购买套餐",
          "订阅成功",
          "开通会员",
          "续费成功"
        ]
      },
      "type": "套餐"
    },
    {
      "when": {
        "title": [
          "到账",
          "收款",
          "支付成功",
          "付款成功",
          "充值成功",
          "新订单"
        ]
      },
      "type": "收款"
    },
    {
      "when": {
        "title": [
          "新用户注册",
          "注册成功",
          "新注册",
          "新账户"
        ]
      },
      "type": "注册"
    },
    {
      "when": {
        "title": [
          "日报",
          "周报"
        ]
      },
      "type": "日报"
    },
    {
      "when": {
        "title": [
          "宕机",
          "不可用",
          "服务中断",
          "【严重】",
          "FIRING",
          "P0",
          "P1"
        ]
      },
      "type": "告警",
      "name": "出严重故障了"
    },
    {
      "when": {
        "title": [
          "告警",
          "报警",
          "熔断",
          "掉线",
          "错误激增",
          "失败率"
        ]
      },
      "type": "告警",
      "name": "有告警"
    },
    {
      "when": {
        "title": [
          "余额不足",
          "额度不足",
          "额度告急",
          "额度用尽"
        ]
      },
      "type": "告警",
      "name": "余额快不够了"
    },
    {
      "when": {
        "title": [
          "待审批",
          "待审核"
        ]
      },
      "type": "提醒",
      "name": "有事项等你审批"
    },
    {
      "when": {
        "title": [
          "新反馈",
          "用户反馈",
          "新工单"
        ]
      },
      "type": "提醒",
      "name": "收到用户反馈"
    }
  ],
  "catchAll": {
    "keywords": [
      "到账",
      "收款",
      "支付",
      "退款",
      "注册",
      "告警",
      "故障",
      "失败",
      "余额"
    ],
    "cooldownMinutes": 10
  },
  "values": {
    "方式": [
      "支付宝",
      "微信",
      "银行卡",
      "Stripe",
      "PayPal",
      "USDT",
      "现金"
    ]
  },
  "aliases": {
    "微信支付": "微信",
    "支付宝支付": "支付宝",
    "Stripe 银行卡": "Stripe",
    "USDT · TRC20": "USDT",
    "USDT · ERC20": "USDT",
    "USDT · BEP20": "USDT"
  }
}