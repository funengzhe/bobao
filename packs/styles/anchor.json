{
  "name": "新闻播报",
  "description": "播音腔，字正腔圆，像电台整点新闻。适合办公室公放、日报。",
  "称呼": "各位",
  "voices": {
    "default": {
      "voice": "Chinese (Mandarin)_News_Anchor"
    },
    "告警": {
      "voice": "Chinese (Mandarin)_News_Anchor"
    },
    "接话": {
      "voice": "Chinese (Mandarin)_News_Anchor"
    }
  },
  "sounds": {
    "收款": "coin",
    "套餐": "coin",
    "注册": "doorbell",
    "日报": "doorbell",
    "告警": "beeps",
    "恢复": "levelup",
    "提醒": "doorbell",
    "通知": "doorbell"
  },
  "pick": {},
  "firstOrder": "新客首单",
  "bigOrderSay": "大额订单",
  "types": {
    "收款": {
      "say": [
        "现在播报一条好消息，{大单}，{平台}收款 {金额}，{方式}，{首单}"
      ]
    },
    "套餐": {
      "say": [
        "现在播报，{平台}售出套餐，{金额}，{套餐}，{首单}"
      ]
    },
    "注册": {
      "say": [
        "{平台}迎来一位新用户"
      ]
    },
    "日报": {
      "say": [
        "{平台}今日日报已经发布，请查收"
      ]
    },
    "告警": {
      "say": [
        "紧急插播，{平台}{名称}，请相关同事立即处理"
      ]
    },
    "恢复": {
      "say": [
        "最新消息，{平台}已经恢复正常"
      ]
    },
    "提醒": {
      "say": [
        "温馨提示，{平台}{名称}"
      ]
    },
    "通知": {
      "say": [
        "{平台}有一条新通知"
      ]
    }
  },
  "tease": {
    "chance": 0,
    "lines": {}
  },
  "health": {
    "say": [
      "播报连接中断，请检查"
    ],
    "back": [
      "播报已恢复"
    ]
  }
}