{
  "name": "销售喊麦",
  "description": "热血、带节奏，适合销售团队和直播间：每一单都要喊出来。",
  "称呼": "兄弟们",
  "voices": {
    "default": {
      "voice": "male-qn-badao-jingpin"
    },
    "告警": {
      "voice": "male-qn-badao-jingpin",
      "emotion": "surprised"
    },
    "接话": {
      "voice": "male-qn-badao-jingpin"
    }
  },
  "sounds": {
    "收款": "coin",
    "套餐": "coin",
    "注册": "doorbell",
    "日报": "doorbell",
    "告警": "beeps",
    "恢复": "levelup",
    "提醒": "doorbell",
    "通知": "doorbell"
  },
  "pick": {
    "开头": [
      "恭喜恭喜",
      "来了来了",
      "{称呼}"
    ],
    "结尾": [
      "掌声送给自己",
      "继续冲",
      "今天必破纪录"
    ]
  },
  "firstOrder": "还是新客户",
  "bigOrderSay": "大单炸裂",
  "types": {
    "收款": {
      "say": [
        "{开头}，{大单}，{平台}又成交一单，{金额}，{首单}，{结尾}"
      ]
    },
    "套餐": {
      "say": [
        "{开头}，{大单}，{平台}拿下一单，{金额}，{套餐}，{首单}，{结尾}"
      ]
    },
    "注册": {
      "say": [
        "{平台}又来一位新朋友，欢迎欢迎",
        "新人进场，{平台}人气起来了"
      ]
    },
    "日报": {
      "say": [
        "{称呼}，{平台}战报来了，看看今天打得怎么样"
      ]
    },
    "告警": {
      "say": [
        "{称呼}，{平台}{名称}，赶紧上"
      ]
    },
    "恢复": {
      "say": [
        "稳了，{平台}恢复正常"
      ]
    },
    "提醒": {
      "say": [
        "{称呼}，{平台}{名称}"
      ]
    },
    "通知": {
      "say": [
        "{平台}有新消息"
      ]
    }
  },
  "tease": {
    "chance": 0.3,
    "lines": {
      "收款": [
        "下一单马上就来",
        "保持这个节奏"
      ],
      "大单": [
        "这单够吃一个月"
      ]
    }
  },
  "health": {
    "say": [
      "{称呼}，播报断了，快来看看"
    ],
    "back": [
      "播报回来了，继续冲"
    ]
  }
}