  "tease": {
    "chance": 0.3,
    "lines": {
      "收款": [
        "今天手气真好",
        "钱包又鼓了一点",
        "继续加油呀",
        "照这样下去要发财啦"
      ],
      "大单": [
        "哇，这一单好大",
        "大老板来啦"
      ],
      "注册": [
        "人气越来越旺啦",
        "又有人来捧场啦"
      ],
      "日报": [
        "今天辛苦啦",
        "明天继续加油哦"
      ],
      "告警": [
        "别着急，慢慢来",
        "加油，一定能修好"
      ]
    }
  },
  "health": {
    "say": [
      "{称呼}，播报断掉了，快来看看我",
      "{称呼}，我连不上消息啦"
