      ]
    },
    "提醒": {
      "say": [
        "{称呼}，{平台}{名称}，有空去看看哦"
      ],
      "tease": false
    },
    "通知": {
      "say": [
        "{称呼}，{平台}有一条新通知，快去看看哦"
      ],
      "tease": false
    }
