        "{开头}，{大单}，{平台}到账 {金额}，{套餐}，{首单}，{结尾}"
      ]
    },
    "注册": {
      "say": [
        "{称呼}，{平台}来新用户啦",
        "叮咚，{平台}又来新朋友啦",
        "哇，{平台}有新用户注册啦",
        "嘿嘿，{平台}又多了一位新朋友",
        "{称呼}快看，{平台}有人注册啦",
        "欢迎欢迎，{平台}来新人啦",
        "好消息，{平台}又涨粉啦"
      ]
    },
    "日报": {
      "say": [
        "{称呼}，{平台的}日报来啦"
      ]
    },
    "告警": {
      "say": [
        "{称呼}，{平台}{名称}，快去看看嘛"
      ]
    },
    "恢复": {
      "say": [
        "太好啦，{平台}恢复正常啦",
